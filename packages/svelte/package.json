{
  "name": "@tomickigrzegorz/autocomplete-svelte",
  "version": "1.0.0",
  "description": "Svelte wrapper for @tomickigrzegorz/autocomplete",
  "author": "Grzegorz Tomicki",
  "license": "MIT",
  "svelte": "./dist/index.svelte",
  "types": "./dist/index.svelte.d.ts",
  "files": ["dist/"],
  "exports": {
    ".": {
      "types": "./dist/index.svelte.d.ts",
      "svelte": "./dist/index.svelte",
      "default": "./dist/index.svelte"
    }
  },
  "sideEffects": false,
  "keywords": [
    "autocomplete",
    "svelte",
    "svelte5",
    "wrapper",
    "typeahead",
    "search",
    "accessibility",
    "aria"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "@tomickigrzegorz/autocomplete": "^3.4.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/svelte": "^5.0.0",
    "jsdom": "^24.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomickigrzegorz/autocomplete.git",
    "directory": "packages/svelte"
  }
}
